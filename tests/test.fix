module Test;

import Base64Test::main;
import BinaryTest::main;
import HexTest::main;
import Minilib.Testing.UnitTest::{TestSuite, TestSuite::run};
import Std::IO;

testsuite: TestSuite;
testsuite = [
    ("HexTest", HexTest::main),
    ("Base64Test", Base64Test::main),
    ("BinaryTest", BinaryTest::main),
];


test: IO ();
test = (
    testsuite.run
);

